DATABASE_URL=postgresql+asyncpg://app:password@localhost:5432/video_workflow
DATABASE_SYNC_URL=postgresql+psycopg2://app:password@localhost:5432/video_workflow
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=video-production
API_KEY=dev-api-key-change-in-prod
# 容器间访问用（docker-compose 里 backend/worker 会覆盖成 minio:9000）
MINIO_ENDPOINT=localhost:9000
# 生成预签名 URL 用，必须是浏览器能访问到的地址，不要设成容器内部 hostname
# 本地开发用 localhost:9000；线上通过 nginx 反代到域名时改成对应域名，并设 MINIO_PUBLIC_SECURE=true
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ANTHROPIC_API_KEY=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_SCRIPT_MAX_TOKENS=8192
DEEPSEEK_JSON_MAX_TOKENS=4096
# Optional USD pricing fallback when the provider response has no cost.
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_CACHED_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
# OpenRouter (AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_SCRIPT_MAX_TOKENS=8192
OPENROUTER_JSON_MAX_TOKENS=4096
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
OPENROUTER_INPUT_COST_PER_MILLION=0
OPENROUTER_CACHED_INPUT_COST_PER_MILLION=0
OPENROUTER_OUTPUT_COST_PER_MILLION=0
# Gemini (AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_SCRIPT_MAX_TOKENS=8192
GEMINI_JSON_MAX_TOKENS=4096
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_CACHED_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0
# Doubao / Volcengine Ark (AI_PROVIDER=doubao)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250615
DOUBAO_TIMEOUT_SECONDS=60
DOUBAO_CONTENT_MAX_TOKENS=8192
DOUBAO_JSON_MAX_TOKENS=4096
DOUBAO_INPUT_COST_PER_MILLION=0
DOUBAO_CACHED_INPUT_COST_PER_MILLION=0
DOUBAO_OUTPUT_COST_PER_MILLION=0

VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
TTS_ENGINE=volcengine
MINIO_BUCKET=video-workflow
MANIM_TIMEOUT_SECONDS=600
